# SVN Solar Consulting - Environment Variables
PORT=3000
NODE_ENV=development

# MongoDB Connection URI (Local or MongoDB Atlas)
# If MongoDB is not reachable, the app automatically runs in resilient file-storage mode
MONGODB_URI=mongodb://127.0.0.1:27017/svn_solar

# Session secret (At least 32 characters long)
SESSION_SECRET=svn-solar-consulting-secure-session-secret-key-2026-xyz

# Default Admin Credentials (Auto-created on first boot)
ADMIN_NAME=SVN Solar Admin
ADMIN_EMAIL=admin@svnsolar.local
ADMIN_PASSWORD="SVNAdmin#2026!"
